# Generated by rstantools, then edited: see the TBB note on PKG_LIBS.

STANHEADERS_SRC = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "message()" -e "cat(system.file('include', 'src', package = 'StanHeaders', mustWork = TRUE))" -e "message()" | grep "StanHeaders")

STANC_FLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "cat(ifelse(utils::packageVersion('rstan') >= '2.26', '-DUSE_STANC3',''))")
PKG_CPPFLAGS = -I"../inst/include" -I"$(STANHEADERS_SRC)" -DBOOST_DISABLE_ASSERTS -DEIGEN_NO_DEBUG -DRCPP_PARALLEL_USE_TBB=1 $(STANC_FLAGS) -D_HAS_AUTO_PTR_ETC=0
PKG_CXXFLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "RcppParallel::CxxFlags()") $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "StanHeaders:::CxxFlags()")
# Link TBB the way RcppParallel currently says to, and do not also take
# StanHeaders' answer. rstantools generates both, which on Windows produces
#
#   -L.../RcppParallel/libs/x64 -lRcppParallel          <- RcppParallelLibs()
#   -L.../RcppParallel/lib/x64 -Wl,-rpath,... -ltbb -ltbbmalloc  <- StanHeaders
#
# and the second half is a RcppParallel 5 era answer that no longer describes
# what is installed. RcppParallel 6.0.0 ships lib/x64/tbb.dll but no import
# library and no tbbmalloc at all, and its .onLoad returns early on Windows, so
# it neither loads tbb.dll nor puts that directory on the DLL search path.
# Linking against them anyway succeeds and then the package cannot be loaded:
#
#   unable to load shared object '.../cpaic/libs/x64/cpaic.dll':
#   LoadLibrary failure: The specified module could not be found.
#
# Taking RcppParallel's own answer alone leaves cpaic.dll depending on
# RcppParallel.dll, which R has already loaded through that package's
# library.dynam() by the time cpaic.dll is loaded, because RcppParallel is an
# import and namespace imports are processed before useDynLib. Fixing this from
# cpaic's own .onLoad is not possible: cpaic.dll is loaded before it runs.
#
# `-DSTAN_THREADS` stays. It says Stan wants the TBB-backed implementation, not
# that this link line must name the TBB libraries itself. Under RcppParallel 5
# `RcppParallelLibs()` returns the tbb flags anyway, so this stays correct there.
# Windows only; Linux and macOS resolve TBB and are left as generated.
PKG_LIBS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "RcppParallel::RcppParallelLibs()")

CXX_STD = CXX17
