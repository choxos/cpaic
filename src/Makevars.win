# Generated by rstantools, then edited: see the tbbmalloc note on PKG_LIBS.

STANHEADERS_SRC = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "message()" -e "cat(system.file('include', 'src', package = 'StanHeaders', mustWork = TRUE))" -e "message()" | grep "StanHeaders")

STANC_FLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "cat(ifelse(utils::packageVersion('rstan') >= '2.26', '-DUSE_STANC3',''))")
PKG_CPPFLAGS = -I"../inst/include" -I"$(STANHEADERS_SRC)" -DBOOST_DISABLE_ASSERTS -DEIGEN_NO_DEBUG -DRCPP_PARALLEL_USE_TBB=1 $(STANC_FLAGS) -D_HAS_AUTO_PTR_ETC=0
PKG_CXXFLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "RcppParallel::CxxFlags()") $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "StanHeaders:::CxxFlags()")
# RcppParallel and StanHeaders both emit "-ltbb -ltbbmalloc", but RcppParallel
# 6.0.0 stopped shipping tbbmalloc.dll on Windows: its binary carries tbb.dll
# and the tbbmalloc headers only. Linking still succeeds, and the package then
# cannot be loaded at all:
#
#   unable to load shared object '.../cpaic/libs/x64/cpaic.dll':
#   LoadLibrary failure: The specified module could not be found.
#
# tbbmalloc is TBB's optional scalable allocator, not part of the Stan runtime,
# so dropping the flag costs nothing and restores the build. Only that flag is
# removed; -ltbb and every -L path are kept exactly as the two packages give
# them, and if a later RcppParallel ships tbbmalloc.dll again this stays inert.
# Windows only: tbbmalloc still resolves on Linux and macOS, which are left as
# rstantools generated them.
PKG_LIBS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "cat(gsub('-ltbbmalloc', '', paste(c(utils::capture.output(RcppParallel::RcppParallelLibs()), utils::capture.output(StanHeaders:::LdFlags())), collapse = ' ')))")

CXX_STD = CXX17
