# Technical documentation (kept local, not version-controlled per project decision)
documentation/

# R / package build artifacts
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
.Rapp.history
*.tar.gz
*.Rcheck/
..Rcheck/
# pkgdown output (.gitignore has no inline comments, so keep this on its own line)
/docs/
/doc/
/Meta/
inst/doc/
/.quarto/

# Compiled Stan / C++ (keep only the .stan sources under inst/stan)
inst/stan/*
!inst/stan/*.stan
!inst/stan/include
*.stanc

# rstantools generates the C++ for each model from inst/stan/*.stan at install
# time, via configure -> rstantools::rstan_config(). Only the Makevars pair is
# authored, so only it is tracked; everything else here is a build product.
src/*
!src/Makevars
!src/Makevars.win

# macOS / editor
.DS_Store
.vscode/
.idea/

# Codegraph / tooling artifacts
.codegraph
.omo/
.claude/

# Agent guidance files (local only, not part of the R package)
CLAUDE.md
AGENTS.md
Rplots.pdf

# knitr cache for the vignette precompile (build artifact, keyed on inputs)
.knitr-cache/
